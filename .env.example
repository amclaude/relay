# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret

# Fernet key for encrypting refresh tokens.
# Generate one with: python scripts/gen_fernet_key.py
FERNET_KEY=replace-with-generated-fernet-key

# Public HTTPS base URL that the Cloudflare tunnel exposes.
# The OAuth redirect URI is PUBLIC_BASE_URL + /oauth/google/callback
PUBLIC_BASE_URL=https://switchboard.crawlshift.dev

# Local port. FastAPI binds to 127.0.0.1 only.
PORT=8742
